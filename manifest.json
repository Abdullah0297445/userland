{
  "products": {
    "traefik": {
      "containers": {
        "traefik": {
          "ports": [80, 443],
          "volumes": ["traefik_acme"],
          "asks": [
            {"var": "DOMAIN", "type": "hostname", "prompt": "Domain every hostname sits under", "when": "public"},
            {"var": "CERT_EMAIL", "type": "email", "prompt": "Email for the ACME account", "when": "public"},
            {"var": "DNS_PROVIDER", "type": "choice", "options": ["route53", "cloudflare"], "prompt": "DNS-01 provider", "when": "public"},
            {"var": "AWS_ACCESS_KEY_ID", "type": "secret", "prompt": "Access key that may write TXT records in the zone", "when": "DNS_PROVIDER=route53"},
            {"var": "AWS_SECRET_ACCESS_KEY", "type": "secret", "prompt": "Its secret", "when": "DNS_PROVIDER=route53"},
            {"var": "CF_DNS_API_TOKEN", "type": "secret", "prompt": "Cloudflare token that may edit DNS in the zone", "when": "DNS_PROVIDER=cloudflare"}
          ]
        }
      }
    },
    "fort": {
      "containers": {
        "fort": {
          "optional": ["postgres-18", "clickhouse"],
          "files": "FORT_FILES",
          "external": {
            "FORT_S3": {"kind": "bucket", "versioned": true, "delete": "locks/*", "never_expire": true},
            "FORT_KEY": {"kind": "secret-store"}
          }
        }
      }
    },
    "postgres": {
      "containers": {
        "postgres-18": {
          "volumes": ["postgres_data"],
          "asks": [
            {"var": "POSTGRES_PASSWORD", "type": "generated", "prompt": "Password of the Postgres superuser"},
            {"var": "PGBOUNCER_AUTH_PASSWORD", "type": "generated", "prompt": "Password of the user the doors look passwords up with"}
          ]
        },
        "pgbouncer-transaction": {
          "requires": ["postgres-18"]
        },
        "pgbouncer-session": {
          "requires": ["postgres-18"]
        },
        "pgadmin": {
          "requires": ["postgres-18"],
          "optional": ["traefik"],
          "http": {"container": 5050, "host": 5050},
          "volumes": ["pgadmin_data"],
          "asks": [
            {"var": "PGADMIN_DEFAULT_EMAIL", "type": "email", "prompt": "Email address you sign in to pgadmin with"},
            {"var": "PGADMIN_DEFAULT_PASSWORD", "type": "generated", "prompt": "Password you sign in to pgadmin with"}
          ]
        }
      }
    },
    "clickhouse": {
      "containers": {
        "clickhouse": {
          "volumes": ["clickhouse_data", "clickhouse_backups"],
          "asks": [
            {"var": "CLICKHOUSE_PASSWORD", "type": "generated", "prompt": "Password of the ClickHouse admin user, default"}
          ]
        }
      }
    },
    "metabase": {
      "containers": {
        "metabase": {
          "requires": ["pgbouncer-transaction"],
          "optional": ["traefik"],
          "http": {"container": 3000, "host": 3000, "subdomain": "metabase"},
          "postgres": {"database": "metabase", "password": "METABASE_DB_PASSWORD"},
          "volumes": ["metabase_plugins"],
          "asks": [
            {"var": "MB_ENCRYPTION_SECRET_KEY", "type": "generated", "prompt": "Key metabase encrypts saved data-source credentials with", "keep": true}
          ]
        }
      }
    },
    "n8n": {
      "containers": {
        "n8n": {
          "requires": ["pgbouncer-transaction"],
          "optional": ["traefik", "n8n-runners"],
          "http": {"container": 5678, "host": 5678},
          "postgres": {"database": "n8n", "password": "N8N_DB_PASSWORD", "settings": {"statement_timeout": "5min"}},
          "volumes": ["n8n_data"],
          "asks": [
            {"var": "N8N_ENCRYPTION_KEY", "type": "generated", "prompt": "Key n8n encrypts saved credentials with", "keep": true}
          ]
        },
        "n8n-runners": {
          "requires": ["n8n"],
          "asks": [
            {"var": "N8N_RUNNERS_AUTH_TOKEN", "type": "generated", "prompt": "Shared secret between n8n and its runners"}
          ]
        }
      }
    },
    "langfuse": {
      "containers": {
        "langfuse-web": {
          "requires": ["pgbouncer-transaction", "pgbouncer-session", "langfuse-redis", "clickhouse"],
          "optional": ["traefik", "langfuse-worker"],
          "http": {"container": 3000, "host": 3001, "subdomain": "langfuse"},
          "postgres": {"database": "langfuse", "password": "LANGFUSE_DB_PASSWORD"},
          "clickhouse": {"database": "langfuse", "password": "LANGFUSE_CLICKHOUSE_PASSWORD"},
          "external": {
            "LANGFUSE_S3": {"kind": "bucket", "delete": "*"}
          },
          "asks": [
            {"var": "LANGFUSE_ENCRYPTION_KEY", "type": "hex", "prompt": "Key langfuse encrypts saved LLM and integration credentials with", "keep": true},
            {"var": "LANGFUSE_SALT", "type": "generated", "prompt": "Salt langfuse hashes API keys with"},
            {"var": "LANGFUSE_NEXTAUTH_SECRET", "type": "generated", "prompt": "Secret langfuse signs sign-in sessions with"},
            {"var": "LANGFUSE_INIT_USER_EMAIL", "type": "email", "prompt": "Email address of the first langfuse account", "when": "public"},
            {"var": "LANGFUSE_INIT_USER_PASSWORD", "type": "generated", "prompt": "Password of the first langfuse account", "when": "public"}
          ]
        },
        "langfuse-worker": {
          "requires": ["langfuse-web", "pgbouncer-transaction", "langfuse-redis", "clickhouse"],
          "postgres": {"database": "langfuse", "password": "LANGFUSE_DB_PASSWORD"},
          "clickhouse": {"database": "langfuse", "password": "LANGFUSE_CLICKHOUSE_PASSWORD"},
          "external": {
            "LANGFUSE_S3": {"kind": "bucket", "delete": "*"}
          }
        },
        "langfuse-redis": {
          "volumes": ["langfuse_redis_data"],
          "asks": [
            {"var": "LANGFUSE_REDIS_PASSWORD", "type": "generated", "prompt": "Password of langfuse's own Redis"}
          ]
        }
      }
    },
    "twenty": {
      "containers": {
        "twenty-server": {
          "requires": ["pgbouncer-session", "twenty-redis"],
          "optional": ["traefik", "twenty-worker"],
          "http": {"container": 3000, "host": 3002, "subdomain": "twenty"},
          "postgres": {"database": "twenty", "password": "TWENTY_DB_PASSWORD"},
          "external": {
            "TWENTY_S3": {"kind": "bucket", "delete": "*"}
          },
          "asks": [
            {"var": "TWENTY_ENCRYPTION_KEY", "type": "generated", "prompt": "Key twenty encrypts its signing keys and saved credentials with", "keep": true}
          ]
        },
        "twenty-worker": {
          "requires": ["twenty-server", "pgbouncer-session", "twenty-redis"],
          "postgres": {"database": "twenty", "password": "TWENTY_DB_PASSWORD"},
          "external": {
            "TWENTY_S3": {"kind": "bucket", "delete": "*"}
          }
        },
        "twenty-redis": {
          "volumes": ["twenty_redis_data"],
          "asks": [
            {"var": "TWENTY_REDIS_PASSWORD", "type": "database-password", "prompt": "Password of twenty's own Redis"}
          ]
        }
      }
    }
  }
}
